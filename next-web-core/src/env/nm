use crate::env::{PropertySource, PropertySources};

/// A `PropertyResolver` implementation that resolves property values against
/// an underlying set of `PropertySources`.
///
/// The resolver walks the property sources in order, returning the first
/// non-null value found for a given key. String values may optionally have
/// nested placeholders resolved before being converted to the target type.
///
/// # See also
///
/// - [`PropertySource`]
/// - [`PropertySources`]
/// - [`AbstractEnvironment`](crate::env::AbstractEnvironment)
pub struct PropertySourcesPropertyResolver {
    /// The property sources to search, if any. `None` means every lookup
    /// returns "not found".
    property_sources: Option<Box<dyn PropertySources>>,
}

impl PropertySourcesPropertyResolver {
    /// Create a new resolver against the given property sources.
    ///
    /// `property_sources` is the set of [`PropertySource`] objects to use.
    /// Passing `None` is allowed and makes every lookup miss.
    pub fn new(property_sources: Option<Box<dyn PropertySources>>) -> Self {
        Self { property_sources }
    }

    /// Return whether any underlying property source contains the given key.
    pub fn contains_property(&self, key: &str) -> bool {
        if let Some(sources) = &self.property_sources {
            for property_source in sources.iter() {
                if property_source.contains_property(key) {
                    return true;
                }
            }
        }
        false
    }

    /// Resolve the given key to a `String`, resolving nested placeholders.
    ///
    /// Returns `None` if the key is not present in any property source.
    pub fn property(&self, key: &str) -> Option<String> {
        self.property_typed(key, TypeId::of::<String>(), true)
    }

    /// Resolve the given key to a value of the target type, resolving nested
    /// placeholders.
    ///
    /// Returns `None` if the key is not present in any property source.
    pub fn property_as<T: 'static>(&self, key: &str) -> Option<T> {
        self.property_typed(key, TypeId::of::<T>(), true)
            .and_then(|v| v.downcast::<T>().ok())
            .map(|b| *b)
    }

    /// Resolve the given key to its raw string form, *without* resolving
    /// nested placeholders.
    pub fn property_as_raw_string(&self, key: &str) -> Option<String> {
        self.property_typed(key, TypeId::of::<String>(), false)
    }

    /// Core lookup: walk the property sources in order, return the first
    /// non-null value, optionally resolve nested placeholders, and convert
    /// to the target type.
    fn property_typed(
        &self,
        key: &str,
        target_value_type: TypeId,
        resolve_nested_placeholders: bool,
    ) -> Option<String> {
        if let Some(sources) = &self.property_sources {
            for property_source in sources.iter() {
                if self.logger.is_trace_enabled() {
                    self.logger.trace(&format!(
                        "Searching for key '{}' in PropertySource '{}'",
                        key,
                        property_source.name()
                    ));
                }
                let mut value = property_source.property(key);
                if let Some(v) = value {
                    if resolve_nested_placeholders {
                        match &v {
                            PropertyValue::Text(s) => {
                                value = Some(self.resolve_nested_placeholders(s));
                            }
                            PropertyValue::CharSequence(cs)
                                if target_value_type == TypeId::of::<String>()
                                    || target_value_type == TypeId::of::<CharSequence>() =>
                            {
                                value = Some(self.resolve_nested_placeholders(&cs.to_string()));
                            }
                            _ => {}
                        }
                    }
                    self.log_key_found(key, property_source.as_ref(), &v);
                    return self.convert_value_if_necessary(v, target_value_type);
                }
            }
        }
        if self.logger.is_trace_enabled() {
            self.logger
                .trace(&format!("Could not find key '{}' in any property source", key));
        }
        None
    }

    /// Log the given key as found in the given [`PropertySource`], resulting in
    /// the given value.
    ///
    /// The default implementation writes a debug log message with the key and
    /// source. It intentionally does *not* log the value, in order to avoid
    /// accidental logging of sensitive settings. Subclasses may override this
    /// method to change the log level and/or message, including the value if
    /// desired.
    ///
    /// `key` is the key found, `property_source` is the source it was found in,
    /// and `value` is the corresponding value.
    fn log_key_found(&self, key: &str, property_source: &dyn PropertySource, value: &PropertyValue) {
        if self.logger.is_debug_enabled() {
            self.logger.debug(&format!(
                "Found key '{}' in PropertySource '{}' with value of type {}",
                key,
                property_source.name(),
                value.type_name()
            ));
        }
    }
}
